end ;LT_TEST6

;Nested associative list of associative lists of asscociative lists and indexed lists and indexed list
entry LT_TEST7
	call LT_TEST_LF_PROCESS_OUTPUT("OBJECT1=OBJECT2=ITEM1=VALUE1[[uNOT]][[uNOT]][[uSEP]]ITEM2=VALUE2[[uNOT]][[uNOT]][[uSEP]]ITEM3=VALUE3[[uNOT]][[uSEP]]OBJECT3=ITEM4=VALUE4[[uNOT]][[uNOT]][[uSEP]]ITEM5=VALUE5[[uNOT]][[uNOT]][[uSEP]]ITEM6=VALUE6[[uNOT]][[uSEP]]ARRAY1=VALUE7[[uNOT]][[uNOT]][[uSEP]]VALUE8[[uNOT]][[uNOT]][[uSEP]]VALUE9[[uSEP]]OBJECT4=ARRAY2=VALUE10[[uNOT]][[uNOT]][[uSEP]]VALUE11[[uNOT]][[uNOT]][[uSEP]]VALUE12[[uSEP]]ARRAY3=VALUE13[[uNOT]][[uSEP]]VALUE14[[uNOT]][[uSEP]]VALUE15", <GC_FALSE>)
end ;LT_TEST7

;Nested array of associative lists of asscociative lists and indexed lists and indexed list
entry LT_TEST8
	call LT_TEST_LF_PROCESS_OUTPUT("OBJECT2=ITEM1=VALUE1[[uNOT]][[uNOT]][[uSEP]]ITEM2=VALUE2[[uNOT]][[uNOT]][[uSEP]]ITEM3=VALUE3[[uNOT]][[uSEP]]OBJECT3=ITEM4=VALUE4[[uNOT]][[uNOT]][[uSEP]]ITEM5=VALUE5[[uNOT]][[uNOT]][[uSEP]]ITEM6=VALUE6[[uNOT]][[uSEP]]ARRAY1=VALUE7[[uNOT]][[uNOT]][[uSEP]]VALUE8[[uNOT]][[uNOT]][[uSEP]]VALUE9[[uSEP]]ARRAY2=VALUE10[[uNOT]][[uNOT]][[uSEP]]VALUE11[[uNOT]][[uNOT]][[uSEP]]VALUE12[[uSEP]]ARRAY3=VALUE13[[uNOT]][[uSEP]]VALUE14[[uNOT]][[uSEP]]VALUE15", <GC_TRUE>)
end ;LT_TEST8

entry LT_TEST_LF_PROCESS_OUTPUT
	params
		string  PV_LIST	: IN
		boolean PV_ARRAY	: IN
	endparams
	putmess $concat("LF_LIST_TO_STRUCT(%%"%%%", PV_LIST, "%%"%%%):%%^%%%", LF_PROCESS_OUTPUT(PV_LIST, PV_ARRAY))
end ;LT_TEST_LF_PROCESS_OUTPUT
#ENDIF



trigger erase
erase
if ($status <0)
   message $text(1763) ;error
   rollback
else
   if ($status = 1)
      message $text(1634) ;not allowed
   else
      message $text(1806) ;OK
      commit
   endif
endif



trigger store
store
if ($status <0)
   message $text(1500) ;error
   rollback
else
   if ($status = 1)
      message $text(1723) ;no change
   else
      commit
      if ($status < 0)
         rollback
      else
         message $text(1805) ;OK
      endif
   endif
endif



trigger retrieveSequential
retrieve
if ($status <0)
   message $text(1765) ;error
endif



trigger retrieve
retrieve
if ($status < 0)
   message $text(1762) ;error
endif



trigger clear
clear



#startdefine

#define $triggerAbbr=LPMX
;ERROR CHECKS ADDED
;Added by ANDY REYNOLDS Date:19-02-2013 Time:15:40:21
entry LP_ERROR
	params
		string PV_ERROR:INOUT
	endparams
	variables
		string TV_LIST,TV_LANG,TV_INSTANCE,TV_ERROR_TEXT,TV_DATASTREAM,TV_TEXT
	endvariables

	if (PV_ERROR = "")
		return(-1)
	endif
	newinstance "GSSESSION", TV_INSTANCE
	#include NTIER:CHECK_ERROR
	activate TV_INSTANCE.GET_SESSION ($LV_SESS_MESS$, "LANGUAGE", TV_LANG)
	#include NTIER:CHECK_ERROR
	deleteinstance TV_INSTANCE
	if (TV_LANG = "")
		return(-1)
	endif

	TV_LIST = "ID=%%PV_ERROR%%%[[uSEP]]LANGUAGE=%%TV_LANG%%%"
	activate "GSVALIDATE".EXISTS ($LV_SESS_MESS$, "EMANMESS", "", TV_LIST)
	#include NTIER:CHECK_ERROR
	if ($status = 0)
	    getitem/id PV_ERROR, TV_LIST, "MESSAGE"
	endif
	return(0)


entry LP_PROCESS_INPUT
params
	string PV_LOGIN:IN	
	string PV_INPUT:IN
	string PV_PAYLOAD:OUT
endparams
variables
	string TV_LIST
	struct TV_STRUCT
	numeric TV_SCAN ; MRB 28/04/26 SPR # 103472
endvariables

	; MRB 28/04/26 SPR # 103472 - web calls coming in with an empty body causes infinite loop
	TV_SCAN = $scan(PV_INPUT, "text/json")
	if (TV_SCAN > 0) && ($item("text/json", PV_INPUT) = "") return (-10)

;mmb spr-82697 - re-instated code (from spr-82323)
    if ($item("text/json",PV_INPUT)!="")
;		TV_LIST = "%%$valuepart(PV_INPUT)%%%="
		TV_LIST = $valuepart(PV_INPUT)
		jsontostruct TV_STRUCT, TV_LIST 
		if ($status<0) ; Fallback... Strange JSON that somehow works
			call LP_JSON2LIST(PV_LOGIN,TV_LIST,PV_PAYLOAD)   
			#include NTIER:CHECK_ERROR
		endif
		call LP_STRUCT2LIST(TV_STRUCT->*,PV_PAYLOAD)

		; MRB 28/04/26 SPR # 103472 
		if (PV_PAYLOAD = "") return (-10)

		return 0 
    else 
		call LP_JSON2LIST(PV_LOGIN,PV_INPUT,PV_PAYLOAD) ; then fallback on Mobile malformed JSON that has a "=" at the end
		#include NTIER:CHECK_ERROR
	endif
end




entry LP_PROCESS_OUTPUT
params
	string PV_OUTPUT:IN
	string PV_WEBOUTPUT:OUT
endparams
	call LP_LIST2JSON(PV_OUTPUT,<GC_FALSE>,PV_WEBOUTPUT)
	#include NTIER:CHECK_ERROR
	PV_WEBOUTPUT="{%%PV_WEBOUTPUT%%%}"
end

entry LP_LIST2JSON
	params
		string PV_LIST :IN
		boolean PV_SINGLE_OBJECT:IN ;SPR #70121/70663 28/08/2013 GS - Need to handle multiple occurences in a list
		string PV_JSON:OUT
	endparams
	variables
		string TV_ID, TV_VALUE,TV_INSTANCE
	endvariables
	newinstance "GSSTRINGFUNC", TV_INSTANCE ;spr 70121
	while (PV_LIST !="")
		TV_ID=$idpart($itemnr(1,PV_LIST))	
		TV_value=$valuepart($itemnr(1,PV_LIST))	
;spr 70121 start
;		activate "GSSTRINGFUNC".JSCRIPT_ESCAPE(TV_ID)	
		activate TV_INSTANCE.JSCRIPT_ESCAPE(TV_ID)
		#include NTIER:CHECK_ERROR		
;		activate "GSSTRINGFUNC".JSCRIPT_ESCAPE(TV_VALUE)	
		activate TV_INSTANCE.JSCRIPT_ESCAPE(TV_VALUE)	
		#include NTIER:CHECK_ERROR
;spr 70121 end

		;SPR #70121/70663 28/08/2013 GS - Cater for a single object output
		if (PV_SINGLE_OBJECT == <GC_TRUE>)
			PV_JSON="%%PV_JSON%%% %%TV_ID%%%:%%"%%TV_VALUE%%%%%""
		else
			PV_JSON="%%PV_JSON%%% %%"%%TV_ID%%%%%":%%"%%TV_VALUE%%%%%""
		endif
		delitem PV_LIST,1
		if (PV_LIST!="")
			PV_JSON="%%PV_JSON%%%,  %%^ "
		endif
	endwhile

	deleteinstance TV_INSTANCE
	TV_INSTANCE = ""
	return(0)
end


entry LP_JSON2LIST
	params
		string PV_LOGIN:IN	
		string PV_JSON:IN
		string PV_LIST :OUT
	endparams
	variables
		string  TV_LIST_WITHIN,TV_FINAL_LIST,TV_DATA
		numeric TV_START, TV_END,TV_JASONFORMAT,TV_START_SQUARE,TV_END_SQUARE 
		string  TV_STRING,TV_LAST_CHARACTER
		numeric TV_LENGTH
		;SPR#79485
		string  TV_RIGHT
		string  TV_LEFT
		string  TV_LOOKFOR
		numeric TV_POSITION
		;SPR 79485 - END
		string TV_AUX	 ;SPR#87196
	endvariables

	;SPR#87196 - Replacement of " in "fields" section - lUIS bURON - 27/02/2017
	TV_AUX = PV_JSON
	TV_START = $scan(TV_AUX, "fields%%"%%%:{%%"%%%")
	if (TV_START > 0)
		TV_START = TV_START + 9
		TV_LEFT = PV_JSON[1,TV_START]
		TV_START = TV_START + 1
		TV_AUX = PV_JSON[TV_START]
		TV_AUX = $replace(TV_AUX,1,"%%"%%%:%%"%%%","<@1@>",-1)
		TV_AUX = $replace(TV_AUX,1,"%%"%%%,%%"%%%","<@2@>",-1)
		;SPR#88424
		TV_AUX = $replace(TV_AUX,1,"%%"%%%}","<@5@>",-1)
		;SPR 88424
		TV_AUX = $replace(TV_AUX,1,"%%"%%%:","<@3@>",-1)
		TV_AUX = $replace(TV_AUX,1,",%%"%%%","<@4@>",-1)
		TV_AUX = $replace(TV_AUX,1,"\\","<@DBSLA@>",-1)
		TV_AUX = $replace(TV_AUX,1,"\%%"%%%","<@DBQUOTE@>",-1)
		TV_AUX = $replace(TV_AUX,1,"%%"%%%","<@DBQUOTE@>",-1)
		TV_AUX = $replace(TV_AUX,1,"<@1@>","%%"%%%:%%"%%%",-1)
		TV_AUX = $replace(TV_AUX,1,"<@2@>","%%"%%%,%%"%%%",-1)
		;SPR#88424
		TV_AUX = $replace(TV_AUX,1,"<@5@>","%%"%%%}",-1)
		;SPR 88424
		TV_AUX = $replace(TV_AUX,1,"<@3@>","%%"%%%:",-1)
		TV_AUX = $replace(TV_AUX,1,"<@4@>",",%%"%%%",-1)
		PV_JSON = "%%TV_LEFT%%%%%TV_AUX%%%"
		TV_LEFT=""
	endif
	;SPR 87196 - END

	;SPR#79485 - Avoid wrong replacement for some characters - Luis Buron - 24/02/2015
	TV_LOOKFOR ='""'
	TV_LOOKFOR = TV_LOOKFOR[1:1]
	TV_POSITION=1
	while (TV_POSITION>0)	
		TV_POSITION=$split(PV_JSON,1, TV_LOOKFOR,TV_LEFT,TV_RIGHT)
		TV_POSITION=$split(TV_RIGHT,1,TV_LOOKFOR,TV_STRING,TV_RIGHT)
		if (TV_POSITION>0)		
			;Replaces in TV_STRING
			TV_STRING = $replace(TV_STRING,1,"\\","<@DBSLA@>",-1)
			TV_STRING= $replace(TV_STRING,1,"\%%"%%%","<@DBQUOTE@>",-1)
			TV_STRING = $replace(TV_STRING,1,":","<@COLON@>",-1)
			TV_STRING= $replace(TV_STRING,1,",","<@COMMA@>",-1)
			TV_STRING= $replace(TV_STRING,1,"%%"","<@DBPER@>",-1)
			TV_STRING = $replace(TV_STRING,1,"%%^","<@BRRET@>",-1)
			TV_STRING = $replace(TV_STRING,1,"	","<@DBSPA@>",-1)
			PV_JSON = "%%TV_LEFT%%%<@DBQUO@>%%TV_STRING%%%<@DBQUO@>%%TV_RIGHT%%%"
			TV_POSITION = $scan(PV_JSON,TV_LOOKFOR)
		endif
	endwhile 	
	PV_JSON = $replace(PV_JSON,1,"<@DBQUO@>",TV_LOOKFOR,-1)	
	TV_STRING=""
	;SPR 79485 - Luis Buron - 24/02/2015 - END

	getitem/id TV_DATA,PV_JSON,"DATA"
	if ($status > 0)
		PV_JSON = $item("DATA",PV_JSON)
		TV_START = $scan(PV_JSON, "{")
		TV_END = $scan(PV_JSON, "}")

		; MRB 16/04/26 SPR # 103447
;		if(TV_START = 0 & TV_END =  0)
;			return(-1)
;		endif
		if ( (TV_START = 0) || (TV_END = 0) ) return (-1)

	endif

	PV_JSON = $replace(PV_JSON,1,"%%^%%%","",-1)
	PV_JSON = $replace(PV_JSON,1,"	","",-1)
	PV_JSON = PV_JSON[3:$length(PV_JSON)]
	TV_LENGTH= $length(PV_JSON)
	while (TV_LENGTH > 0)
		TV_LAST_CHARACTER = PV_JSON[TV_LENGTH:TV_LENGTH]
		scan TV_LAST_CHARACTER,"="
		if ($result = 1)
			PV_JSON = PV_JSON[1:$length(PV_JSON)-1]
		endif
		scan TV_LAST_CHARACTER," "
		if ($result = 1)
			PV_JSON = PV_JSON[1:$length(PV_JSON)-1]
		endif
		scan TV_LAST_CHARACTER,")"
		if ($result = 1)
			PV_JSON = PV_JSON[1:$length(PV_JSON)-1]
		endif
		scan TV_LAST_CHARACTER,"}"
		if ($result = 1)
			PV_JSON = PV_JSON[1:$length(PV_JSON)-1]
			break
		endif
		TV_LENGTH = $length(PV_JSON)
	endwhile

	;spr 70121 start
	TV_START = $scan(PV_JSON, "[")
	TV_END = $scan(PV_JSON, "]")
	if(TV_START <= 0 & TV_END <= 0)
		TV_START = $scan(PV_JSON, "{")
		TV_END = $scan(PV_JSON, "}")
		TV_LIST_WITHIN = PV_JSON[TV_START + 1,TV_END - 1]
	else ;we have a list!
		TV_LIST_WITHIN = PV_JSON[TV_START + 1,TV_END - 1]
		TV_LIST_WITHIN = $replace(TV_LIST_WITHIN, 1, "%%"%%%,%%"%%%", "[[uNOT]]%%"%%%,%%"%%%", -1)
	endif
	if(TV_START > 0 & TV_END > 0)
		TV_LIST_WITHIN = $replace(TV_LIST_WITHIN,1,":","=",-1)
		TV_LIST_WITHIN = $replace(TV_LIST_WITHIN,1,",","[[uNOT]][[uSEP]]",-1)
		TV_LIST_WITHIN = $replace(TV_LIST_WITHIN,1,"%%"","",-1)
		TV_LIST_WITHIN = $replace(TV_LIST_WITHIN,1,"}","",-1)
		TV_LIST_WITHIN = $replace(TV_LIST_WITHIN,1,"{","",-1)
	;spr 70121 end
	endif
	PV_LIST = "%%PV_JSON[1,TV_START - 1]%%%%%TV_LIST_WITHIN%%%%%PV_JSON[TV_END + 1]%%%"
	PV_LIST= $replace(PV_LIST,1,":","=",-1)
	PV_LIST= $replace(PV_LIST,1,",","[[uSEP]]",-1)
	PV_LIST= $replace(PV_LIST,1,"%%"","",-1)
	PV_LIST = $replace(PV_LIST,1,"%%^","",-1)
	PV_LIST = $replace(PV_LIST,1,"	","",-1)
	;SPR#87160 - Manage also \r and strings like '\nwhatever' - Luis Buron - 17/02/2017
	PV_LIST = $replace(PV_LIST,1,"\r\n","%%^",-1)
	;SPR 87160 - END
	;spr 70121 start
	PV_LIST = $replace(PV_LIST,1,"\n","%%^",-1)
	;spr 70121 end
	;SPR#87160 - Manage also \r and strings like '\nwhatever' - Luis Buron - 17/02/2017
	PV_LIST = $replace(PV_LIST,1,"\r","%%^",-1)
	;SPR 87160 - END

	;SPR#79485 - Luis Buron - 24/02/2015
	PV_LIST= $replace(PV_LIST,1,"<@COLON@>",":",-1)
	PV_LIST= $replace(PV_LIST,1,"<@COMMA@>",",",-1)
	PV_LIST= $replace(PV_LIST,1,"<@DBPER@>","%%"",-1)
	PV_LIST = $replace(PV_LIST,1,"<@BRRET@>","%%^",-1)
	PV_LIST = $replace(PV_LIST,1,"<@DBSPA@>","	",-1)
	;SPR#87160 - Manage also \r and strings like '\nwhatever' - Luis Buron - 17/02/2017
	PV_LIST = $replace(PV_LIST,1,"<@DBSLA@>","\",-1)
	;SPR 87160 - END
	;SPR#87196
	PV_LIST = $replace(PV_LIST,1,"<@DBQUOTE@>","%%"%%%",-1)
	;SPR 87196 - END
	;SPR 79485 - 24/02/2015 - END

	return(0)
end ;LP_JSON2LIST


;SPR #70121/70663 28/08/2013 GS - Need to handle multiple occurences in a list
entry LP_PROCESS_MULTIPLE_OUTPUT
	params
		string  PV_OUTPUT:IN
		boolean PV_SINGLE_OBJECT:IN
		string  PV_WEBOUTPUT:OUT
	endparams
	variables
		string TV_ITEM
		numeric TV_POSITION
	endvariables

	TV_POSITION = 1
	getitem TV_ITEM, PV_OUTPUT, TV_POSITION
	
	if (PV_SINGLE_OBJECT == <GC_TRUE>)
		PV_WEBOUTPUT = "[{"
	else
		PV_WEBOUTPUT = "["
	endif

	while (TV_ITEM != <GC_NULL>)
;		if (PV_WEBOUTPUT != "%%^[" && PV_WEBOUTPUT[$length(PV_WEBOUTPUT)] != "[")
		if (PV_WEBOUTPUT[$length(PV_WEBOUTPUT)] != "[" && PV_WEBOUTPUT != "[{")
			PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,",")
		endif

		if ($scan(TV_ITEM, "[[uNOT]]") > 0)
			call LP_PROCESS_INNER_LIST(TV_ITEM,PV_SINGLE_OBJECT,TV_ITEM)
			#include NTIER:CHECK_ERROR
		else
			call LP_LIST2JSON(TV_ITEM,PV_SINGLE_OBJECT,TV_ITEM)
			#include NTIER:CHECK_ERROR
		endif
		if (PV_SINGLE_OBJECT)
			PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,TV_ITEM)
		else
			PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,"%%^{%%^", TV_ITEM,"%%^}%%^")
		endif
		TV_POSITION = (TV_POSITION + 1)
		getitem TV_ITEM, PV_OUTPUT, TV_POSITION
	endwhile

	if (PV_SINGLE_OBJECT == <GC_TRUE>)
		PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,"}]")
	else
		PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,"]")
	endif
	return (<GC_OK>)
end

;SPR #70121/70663 28/08/2013 GS - Need to handle multiple occurences in a list
entry LP_PROCESS_INNER_LIST
	params
		string  PV_OUTPUT:IN
		boolean PV_SINGLE_OBJECT:IN
		string  PV_WEBOUTPUT:OUT
	endparams
	variables
		string  TV_FIELD
		string  TV_VALUE
		string  TV_ITEM
		numeric TV_POSITION
		numeric TV_SPLIT
	endvariables
	

	$result = $split(PV_OUTPUT, 1, "=", TV_FIELD, TV_VALUE)
	TV_POSITION = 1
	if (PV_SINGLE_OBJECT)
		PV_WEBOUTPUT = "%%TV_FIELD%%%: ["
	else
		PV_WEBOUTPUT = "%%"%%%%%TV_FIELD%%%%%"%%%: ["
	endif
	if (($scan(TV_VALUE, "=") == 0) && ($scan(TV_VALUE, "[[uNOT]][[uSEP]]") != 0)) ;Associative list
		TV_VALUE = $replace(TV_VALUE,1,"[[uNOT]][[uSEP]]","[[uSEP]]",-1)
		getitem TV_ITEM, TV_VALUE, TV_POSITION
		while (TV_ITEM != <GC_NULL>)
			if (PV_WEBOUTPUT[$length(PV_WEBOUTPUT)] != "[") PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,",")
			if ($scan(TV_ITEM, "[[uNOT]][[uSEP]]") > 0)
				call LP_PROCESS_INNER_LIST(TV_ITEM,PV_SINGLE_OBJECT,TV_ITEM)
				#include NTIER:CHECK_ERROR
			endif
			PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,"%%"%%%",TV_ITEM,"%%"%%%")
			TV_POSITION = (TV_POSITION + 1)
			getitem TV_ITEM, TV_VALUE, TV_POSITION
		endwhile
	else ; indexed list
		getitem TV_ITEM, TV_VALUE, TV_POSITION
		while (TV_ITEM != <GC_NULL>)
;			if (PV_WEBOUTPUT != "%%"%%%%%TV_FIELD%%%%%"%%%: [")
			if (PV_WEBOUTPUT[$length(PV_WEBOUTPUT)] != "[")
				PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,",")
			endif
			if ($scan(TV_ITEM, "[[uNOT]][[uSEP]]") > 0)
				call LP_PROCESS_INNER_LIST(TV_ITEM,PV_SINGLE_OBJECT,TV_ITEM)
				#include NTIER:CHECK_ERROR
			endif

			call LP_LIST2JSON(TV_ITEM,PV_SINGLE_OBJECT,TV_ITEM)
			#include NTIER:CHECK_ERROR

			PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,"%%^{%%^", TV_ITEM,"%%^}%%^")
			TV_POSITION = (TV_POSITION + 1)
			getitem TV_ITEM, TV_VALUE, TV_POSITION
		endwhile
	endif
	PV_WEBOUTPUT = $concat(PV_WEBOUTPUT,"]")
	return (<GC_OK>)
end

;SPR#79485 - Luis Buron - 24/02/2015 
;This local procedure was missing
entry LP_ENCODE
	params
		string PV_STRING	: INOUT
	endparams
	if ($LV_GSSTRINGFUNC$ == <GC_NULL>)
		newinstance "GSSTRINGFUNC", $LV_GSSTRINGFUNC$
		if ($status < 0)
			activate "GSSTRINGFUNC".JSCRIPT_ESCAPE(PV_STRING)
			if ($status < 0) return (<GC_STOP>)
		endif
	endif
	$LV_GSSTRINGFUNC$->JSCRIPT_ESCAPE(PV_STRING)
	if ($status < 0)
		activate "GSSTRINGFUNC".JSCRIPT_ESCAPE(PV_STRING)
		if ($status < 0) return (<GC_STOP>)
	endif
	return (<GC_OK>) 
end ;LP_ENCODE

;Inform the Audit Trail, user has logged on
entry LP_AUDIT_LOGIN
	params
		string  PV_MESSAGE :INOUT
		numeric PV_ULEVEL  :IN
	endparams
	variables
		string TV_BEFORE
		string TV_AFTER
		string TV_KEYS
		string TV_FIELD
		string TV_VALUE
		string TV_NEWROW
		string TV_PARAMS
		string TV_FNAME
		string TV_SNAME
		string TV_SCREEN
		string TV_STATUS
		string TV_FIELDFROM
		string TV_VALUEFROM
		string TV_VALUETO
		string TV_SERVERCONTEXT, TV_SERVERVARIABLES, TV_IPADDRESS, TV_USERNAME ; SPR #101460 - 18/10/2023 - Jon Clark
		boolean TV_ADD_SESS_ID ; SPR #101460 - 24/10/2023 - Jon Clark
	endvariables
	
	putitem/id TV_PARAMS, "ENAME",      "LOGIN"
	putitem/id TV_PARAMS, "SNAME",      "SPDEDJSONSERVICE"

	; SPR #101460 - 18/10/2023 - Jon Clark
	; get all of the variables
	call GP_APIAUDITVARS($LV_SESS_ID$, TV_SERVERCONTEXT, TV_IPADDRESS, TV_USERNAME)
	; SPR #101460 - 18/10/2023 - END

	; MRB 02/03/16 SPR # 82323
;	putitem/id TV_PARAMS, "SCREEN",     "Manhattan Mobile Password Entry"
	if ($item("text/json", $webinfo("input")) != "")
		putitem/id TV_PARAMS, "SCREEN", "API Password Entry"
	else
		putitem/id TV_PARAMS, "SCREEN", "Manhattan Mobile Password Entry"
	endif
	; End MRB

	putitem/id TV_PARAMS, "TRAIL_TYPE", "LOGIN"
	putitem/id TV_PARAMS, "PK",         "LOGIN"
	if (PV_ULEVEL = 9)
		; SPR #101460 - 18/10/2023 - Jon Clark
		;putitem/id TV_PARAMS, "MESSAGE", "Logged in with an authorisation level of %%PV_ULEVEL%%% - Super User."
		putitem/id TV_PARAMS, "MESSAGE", $concat("Logged in with an authorisation level of %%PV_ULEVEL%%% - Super User.", "%%^", TV_SERVERCONTEXT)
		; SPR #101460 - 18/10/2023 - END
	else
		; SPR #101460 - 18/10/2023 - Jon Clark
		;putitem/id TV_PARAMS, "MESSAGE", "Logged in with an authorisation level of %%PV_ULEVEL%%%."
		putitem/id TV_PARAMS, "MESSAGE", $concat("Logged in with an authorisation level of %%PV_ULEVEL%%%.", "%%^", TV_SERVERCONTEXT)
		; SPR #101460 - 18/10/2023 - END
	endif
	putitem/id TV_PARAMS, "DESC",       ""
	putitem/id TV_PARAMS, "FNAME",      "LOGON"
	; SPR #101460 - 18/10/2023 - Jon Clark
	;putitem/id TV_PARAMS, "FIELD_FROM", ""
	;putitem/id TV_PARAMS, "FIELD_TO",   ""
	putitem/id TV_PARAMS, "FIELD_FROM", $LV_SESS_ID$
	putitem/id TV_PARAMS, "FIELD_TO",   TV_IPADDRESS
	; SPR #101460 - 18/10/2023 - END

	
	activate "BSAUDITTRAIL".LOGIT(PV_MESSAGE, TV_PARAMS)
	#include NTIER:CHECK_ERROR
	if ($status=<GC_OK>)
		commit
	endif

	return <GC_OK>
end ;LP_AUDIT_LOGIN
;SPR 79485 - 24/02/2015 - END				

; #SPR 101460 - 06/10/2023 - Jon Clark
