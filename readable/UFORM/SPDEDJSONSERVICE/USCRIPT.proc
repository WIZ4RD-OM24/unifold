		numeric PV_ULEVEL  :IN
	endparams
	variables
		string TV_BEFORE, TV_AFTER, TV_KEYS, TV_FIELD, TV_VALUE, TV_NEWROW, TV_PARAMS, TV_FNAME
		string TV_SNAME, TV_SCREEN, TV_STATUS, TV_FIELDFROM, TV_VALUEFROM, TV_VALUETO
		string TV_SESS_ID, TV_SERVERCONTEXT, TV_SERVERVARIABLES, TV_IPADDRESS, TV_REQUEST, TV_DESC, TV_USERNAME ; SPR #101460 - 18/10/2023 - Jon Clark
		boolean TV_ADD_SESS_ID ; SPR #101460 - 18/10/2023 - Jon Clark
	endvariables
	
	putitem/id TV_PARAMS, "ENAME",      "FAILURE"
	putitem/id TV_PARAMS, "SNAME",      "SPDEDJSONSERVICE"

	; SPR #101460 - 18/10/2023 - Jon Clark
	; get all of the variables
	call GP_APIAUDITVARS($LV_SESS_ID$, TV_SERVERCONTEXT, TV_IPADDRESS, TV_USERNAME)
	TV_USERNAME = LF_GETUSERNAME()
	; SPR #101460 - 18/10/2023 - END

	if ($item("text/json", $webinfo("input")) != "")
		putitem/id TV_PARAMS, "SCREEN", "API Password Entry"
	else
		putitem/id TV_PARAMS, "SCREEN", "Manhattan Mobile Password Entry"
	endif

	putitem/id TV_PARAMS, "TRAIL_TYPE", "LOGIN"
	putitem/id TV_PARAMS, "PK",         "LOGIN"
	putitem/id TV_PARAMS, "DESC",       "" ; add in extra information here
	putitem/id TV_PARAMS, "FNAME",      "LOGON"
	; SPR #101460 - 18/10/2023 - Jon Clark
	;putitem/id TV_PARAMS, "FIELD_FROM", ""
	;putitem/id TV_PARAMS, "FIELD_TO",   ""
	putitem/id TV_PARAMS, "USERNAME", TV_USERNAME

	putitem/id TV_PARAMS, "MESSAGE", $concat("User Failed to Login.", "%%^",  $webinfo("input"), "%%^", TV_SERVERCONTEXT)
	;putitem/id TV_PARAMS, "MESSAGE", $concat($webinfo("input"), "%%^", "TV_USERNAME=", TV_USERNAME)
	if ( TV_ADD_SESS_ID	)
		putitem/id TV_PARAMS, "FIELD_FROM", $LV_SESS_ID$
	endif
	putitem/id TV_PARAMS, "FIELD_TO",   TV_IPADDRESS
	; SPR #101460 - 18/10/2023 - END

	activate "BSAUDITTRAIL".LOGIT(PV_MESSAGE, TV_PARAMS)
	#include NTIER:CHECK_ERROR
	if ($status=<GC_OK>)
		commit
	endif

	return <GC_OK>
end ;LP_AUDIT_LOGIN_FAIL

