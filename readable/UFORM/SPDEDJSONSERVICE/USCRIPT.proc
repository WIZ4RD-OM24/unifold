entry  LP_STRUCT2LIST
	params 
		struct TV_STRUCT : IN
		string TV_LIST   :INOUT
	endparams
	variables
		string TV_ITEM
		numeric TV_LOOP
	endvariables
	TV_LOOP=1
	while (TV_LOOP<=TV_STRUCT->$collsize)
		if (TV_STRUCT{TV_LOOP}->$isleaf)
			if (TV_STRUCT{TV_LOOP}->$name!="")
				putitem/id TV_LIST,TV_STRUCT{TV_LOOP}->$name,TV_STRUCT{TV_LOOP}->*
			else
				putitem TV_LIST,-1,TV_STRUCT{TV_LOOP}
			endif
		else
			call LP_struct2list (TV_STRUCT{TV_LOOP}->*,TV_ITEM)
			if (TV_STRUCT{TV_LOOP}->$name!="")
				putitem/id TV_LIST,TV_STRUCT{TV_LOOP}->$name,TV_ITEM
			else
				putitem TV_LIST,-1,TV_ITEM
				
			endif
		endif
		TV_LOOP=TV_LOOP+1
	endwhile
	
end

;SPR #94093 24/04/2019 GS - Yet another nested list to JSON builder to rule all others. (nice LOR reference :))
entry LF_PROCESS_OUTPUT
	returns string
	params
		string  PV_LIST	: IN
		boolean PV_ARRAY	: IN ;List is an array (otherwise it is an object)
	endparams
	variables
		string  TV_JSON
	endvariables
	if (PV_ARRAY)
		structToJson TV_JSON, LF_ARRAY_TO_STRUCT(PV_LIST)
		#include NTIER:CHECK_ERROR
	else
		structToJson TV_JSON, LF_OBJECT_TO_STRUCT(PV_LIST)
		#include NTIER:CHECK_ERROR
	endif
	return TV_JSON
end ;LF_PROCESS_OUTPUT

entry LF_ARRAY_TO_STRUCT
	returns struct
	params
		string  PV_LIST	: IN
	endparams
	variables
		numeric TV_POS
		string  TV_ITEM
		struct  TV_STRUCT
	endvariables
	TV_STRUCT = $newStruct
	TV_STRUCT->$tags->jsonClass = "array"
	forlist TV_ITEM, TV_POS in PV_LIST
		if ($valuepart(TV_ITEM) != TV_ITEM)
			TV_STRUCT->*{TV_POS} = LF_OBJECT_TO_STRUCT(TV_ITEM)
		elseif ($itemcount(TV_ITEM) > 1)
			TV_STRUCT->*{TV_POS} = LF_ARRAY_TO_STRUCT(TV_ITEM)
		else
			TV_STRUCT->*{TV_POS} = TV_ITEM
		endif
	endfor
	return TV_STRUCT
end ;LF_ARRAY_TO_STRUCT

entry LF_OBJECT_TO_STRUCT
	returns struct
	params
		string  PV_LIST	: IN
	endparams
	variables
		string  TV_IDPART, TV_VALUEPART
		struct  TV_STRUCT
	endvariables
	TV_STRUCT = $newStruct
	TV_STRUCT->$tags->jsonClass = "object"
	forlist/id TV_IDPART, TV_VALUEPART in PV_LIST
		if ($valuepart(TV_VALUEPART) != TV_VALUEPART)
			TV_STRUCT->"%%TV_IDPART%%%" = LF_OBJECT_TO_STRUCT(TV_VALUEPART)
		elseif ($itemcount(TV_VALUEPART) > 1)
			TV_STRUCT->"%%TV_IDPART%%%" = LF_ARRAY_TO_STRUCT(TV_VALUEPART)
		else
			TV_STRUCT->"%%TV_IDPART%%%" = TV_VALUEPART
		endif
	endfor
	return TV_STRUCT
end ;LF_OBJECT_TO_STRUCT

entry LP_CLEAR_COOKIE
	variables
		string  TV_REQUEST_URI, TV_SERVLET_PATH, TV_SERVERVARIABLES, TV_COOKIESOUT, TV_PATH
		numeric    TV_FROM
	endvariables
	
	getitem/id TV_SERVERVARIABLES, $webinfo("webservercontext"), "SERVERVARIABLES"
	getitem/id TV_REQUEST_URI, TV_SERVERVARIABLES, "REQUEST_URI"
	getitem/id TV_SERVLET_PATH, TV_SERVERVARIABLES, "SERVLET_PATH"
	if(TV_REQUEST_URI != "" & TV_SERVLET_PATH != "")
		TV_FROM = $scan(TV_REQUEST_URI, TV_SERVLET_PATH)
		putitem/id TV_PATH, "path", TV_REQUEST_URI[1,TV_FROM]
	endif

	; Jon C - error checking
	; need to check the payload for text/plain
	
;SPR #69506 05/06/2013 GS - Ensure cookie is cleared for Uniface 9
	#if ( <UNIFACEVERS> == 9 )
		;SPR #76307/76539 24/10/2014 GS - Clear session when using container based security (Logout needs to destroy the container's session)
		if ($uppercase($logical("SSO_MODE"))="TOMCAT_JNDI" && ($logical("SSO_LOGOUT_URL") == <GC_NULL>))
			;Invalidate session if no logout page is defined (otherwise the container session will still exist)
			$webinfo("UserContext") = "1[[uSEP]]httponly=F[[uSEP]]%%TV_PATH%%%"
			TV_COOKIESOUT = "UwdSessionID=1[[uNOT]][[uSEP]]httponly=F"
		else ;SPR 76307 ends (perhaps expires=0 should be set below?)
			$webinfo("UserContext") = "[[uSEP]]httponly=F[[uSEP]]%%TV_PATH%%%"
			TV_COOKIESOUT = "UwdSessionID=[[uNOT]][[uSEP]]httponly=F"
		endif
;SPR 69506 end
	#else
		;SPR #76307/76539 24/10/2014 GS - Clear session when using container based security (Logout needs to destroy the container's session)
		if ($uppercase($logical("SSO_MODE"))="TOMCAT_JNDI" && ($logical("SSO_LOGOUT_URL") == <GC_NULL>))
			;Invalidate session if no logout page is defined (otherwise the container session will still exist)
			$webinfo("UserContext") = "1"
			TV_COOKIESOUT = "UwdSessionID=1"
		else ;SPR 76307 ends (perhaps expires=0 should be set below?)
			$webinfo("UserContext") = ""
			TV_COOKIESOUT = "UwdSessionID="
		endif
	#endif
	if(TV_PATH != "")
		TV_COOKIESOUT = "%%TV_COOKIESOUT%%%[[uNOT]][[uSEP]]%%TV_PATH%%%"
	endif
	
	$webinfo("cookiesout") = TV_COOKIESOUT
	
	return <GC_OK>
	
end ;LP_CLEAR_COOKIE


; SPR #101460 - 19/10/2023 - Jon Clark
; Inform the Audit Trail, that something has failed
entry LP_AUDIT_FAIL
	params
		string  PV_MESSAGE 			: INOUT
		string  PV_ULEVEL  			: IN
		string  PV_ERROR_MESSAGE 	: IN
	endparams
	variables
		string TV_BEFORE
		string TV_AFTER
		string TV_KEYS
		string TV_FIELD
		string TV_VALUE
		string TV_NEWROW
		string TV_PARAMS
		string TV_FNAME
		string TV_SNAME
		string TV_SCREEN
		string TV_STATUS
		string TV_FIELDFROM
		string TV_VALUEFROM
		string TV_VALUETO
		string TV_SESS_ID, TV_SERVERCONTEXT, TV_SERVERVARIABLES, TV_IPADDRESS, TV_REQUEST, TV_DESC, TV_USERNAME, TV_SESSIONID_PAYLOAD, TV_METHOD ; SPR #101460 - 18/10/2023 - Jon Clark
		boolean TV_ADD_SESS_ID ; SPR #101460 - 18/10/2023 - Jon Clark
	endvariables

	$LV_FAILURE$ = <GC_FALSE>
	
	putitem/id TV_PARAMS, "ENAME",      "FAILURE"
	putitem/id TV_PARAMS, "SNAME",      "SPDEDJSONSERVICE"


	; get all of the variables
	call GP_APIAUDITVARS($LV_SESS_ID$, TV_SERVERCONTEXT, TV_IPADDRESS, TV_USERNAME)
	TV_USERNAME = LF_GETUSERNAME()
	TV_METHOD= LF_GETMETHOD()
	; SPR #101460 - 18/10/2023 - END

	putitem/id TV_PARAMS, "TRAIL_TYPE", "DO"
	putitem/id TV_PARAMS, "PK",         "DO"
	putitem/id TV_PARAMS, "MESSAGE", $concat(PV_ERROR_MESSAGE, "%%^",  TV_SERVERCONTEXT, "%%^",  TV_REQUEST)
	putitem/id TV_PARAMS, "DESC",       ""
	putitem/id TV_PARAMS, "FNAME",      "DO"
	putitem/id TV_PARAMS, "FIELD_FROM", $LV_SESS_ID$
	putitem/id TV_PARAMS, "FIELD_TO",   TV_IPADDRESS
	putitem/id TV_PARAMS, "SCREEN",   TV_METHOD

	activate "BSAUDITTRAIL".LOGIT_API(PV_MESSAGE, TV_PARAMS)
	#include NTIER:CHECK_ERROR
	if ($status=<GC_OK>)
		commit
	endif

	return <GC_OK>
end ;LP_AUDIT_FAIL

entry LF_GETUSERNAME
	returns string
	variables
		struct TV_STRUCT
		string TV_USERNAME, TV_INPUT
	endvariables

	TV_INPUT = $replace($webinfo("input"), 1, "text/json=", "", 1)
	jsontostruct TV_STRUCT, TV_INPUT
	TV_USERNAME = TV_STRUCT->"username"->$scalar

	return TV_USERNAME

end ; LF_GETUSERNAME

entry LF_GETMETHOD
	returns string
	variables
		struct TV_STRUCT
		string TV_METHOD, TV_INPUT
	endvariables

	TV_INPUT = $replace($webinfo("input"), 1, "text/json=", "", 1)
	jsontostruct TV_STRUCT, TV_INPUT
	TV_METHOD = TV_STRUCT->"method"->$scalar

	return TV_METHOD

end ; LF_GETMETHOD

; Inform the Audit Trail, that something has failed
entry LP_AUDIT_SUCCESS
	params
		string  PV_MESSAGE : INOUT
		string  PV_ULEVEL  : IN
		string  PV_ERROR_MESSAGE : IN
		string  PV_OPERATION	:	IN
	endparams
	variables
