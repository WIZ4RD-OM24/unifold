entry LT_TEST1
	call LT_TEST_LF_PROCESS_OUTPUT("success=true[[uSEP]]message=[[uSEP]]sessionID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx[[uSEP]]language=ENG[[uSEP]]labellanguage=[[uSEP]]error=false[[uSEP]]errorId=Log in successful[[uSEP]]fullName=mobile[[uSEP]]role=[[uSEP]]contact=MOBILE[[uSEP]]RLS_WHERE=(RLS_GROUP IS NULL)[[uSEP]]userEmail=[[uSEP]]params=WOPARTSOPT=", <GC_FALSE>)
end ;LT_TEST1

;Indexed list
entry LT_TEST2
	call LT_TEST_LF_PROCESS_OUTPUT("ITEM1[[uSEP]]ITEM2[[uSEP]]ITEM3[[uSEP]]ITEM4[[uSEP]]ITEM5", <GC_TRUE>)
end ;LT_TEST2

;Associative list
entry LT_TEST3
