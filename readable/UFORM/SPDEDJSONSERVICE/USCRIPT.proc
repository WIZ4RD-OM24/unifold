; The 'exec' operation is needed to access the static server page from a web client.
public web
; Your VARIABLES block here (optional)...

  ; Your pre-edit code here...

  webget   ; Load data submitted by web client
  if ($procerror == 0)
    ;webgen ; Generate a response based on the layout and component data
  else
	; Your error handling here...
  endif

  ; Your post-edit code here...

  ;   ;return 0    ; return >= 0 typically indicates a succesful execution
  ;return 0

	public web
#IF (<LC_DEBUG> == <GC_TRUE>)
#WARNING "Component is compilied with debug proc: DO NOT PATCH PAST DEVTEST"

call LT_TEST1
call LT_TEST2
call LT_TEST3
call LT_TEST4
call LT_TEST5
call LT_TEST6
call LT_TEST7
